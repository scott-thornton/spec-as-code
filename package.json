{
  "name": "spec-as-code",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-as-Code: declarative requirements, validated plans, bounded agent execution, and requirement status that comes from actually running the verification.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scott-thornton/spec-as-code.git"
  },
  "author": "Scott Thornton",
  "license": "MIT",
  "keywords": [
    "spec-as-code",
    "plan-as-code",
    "requirements",
    "agents",
    "verification",
    "developer-tools"
  ]
}
